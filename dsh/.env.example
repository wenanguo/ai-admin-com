# 独立 dsh 项目的环境变量模板 —— **复制成 .env 再填真值**。
#
#   cp .env.example .env
#
# ⚠️ **`.env` 已被 gitignore** ⇒ 真值只在你自己的机器上 ⇒ 仓库里搜不到密钥。
# ⚠️ **凭据只走环境变量** ⇒ dsh 的补丁里只写**变量名**（`apiKeyEnv`）⇒ 密钥不落盘。
# ⚠️ **不许写 `DSH_` 开头的键** ⇒ dsh 的 app-boot 拒收 `.env` 文件里的 `DSH_*`
#    （`BOOTSTRAP_PREFIXES`）⇒ 照着写会让 dsh **拒绝启动**。
#
# ── 凭据（**必填**）────────────────────────────────────────────────────────
# MiniMax 的 key：https://platform.minimaxi.com 控制台 ⇒ 「API Key」
MINIMAX_CN_API_KEY=

# ── 模型路由（**都有缺省** ⇒ 不用改也能跑）─────────────────────────────────
# 路由名（= dsh 的 provider 名；MiniMax 这个名字在 dsh 的目录里 ⇒ 有计价信息）
STANDALONE_PROVIDER=minimax
# 模型 id（⚠️ **别用 MiniMax-M3.1-Flash** ⇒ 实测它在 headless 里只读不写 ⇒ 用全量 M3）
STANDALONE_MODEL=MiniMax-M3
# OpenAI 兼容的根地址（到 /v1 为止）
STANDALONE_BASE_URL=https://api.minimaxi.com/v1
# key 放在哪个环境变量里（**只写名字** ⇒ 密钥不落盘）
STANDALONE_API_KEY_ENV=MINIMAX_CN_API_KEY

# ── 本项目自己的几项（**可选**）─────────────────────────────────────────────
# dsh 的 home（profile / 日志 / 会话）
# STANDALONE_HOME=./.dsh-home
# dsh 的具名 profile
# STANDALONE_PROFILE=standalone
# 要不要装本仓的插件（off = 纯 dsh，不带 AiAdmin 的命令与提示词）
# STANDALONE_PLUGIN=on
# 外部插件的源码目录（按 file: 引用 ⇒ 不复制源码）
# STANDALONE_PLUGIN_PATH=../backend/ai/dsh-plugin
# 技能目录（JSON 数组或逗号分隔）⇒ 只认这些目录
# STANDALONE_SKILL_DIRS=["/abs/path/to/skills"]
# 系统提示词文件（⇒ 交给插件 ⇒ 进模型上下文）
# STANDALONE_SYSTEM_PROMPT_FILE=./prompt.md
# 上下文窗口 / 单次输出上限（token）
# STANDALONE_CONTEXT_WINDOW=262144
# STANDALONE_MAX_TOKENS=32768
