# 复制成 .env 后填真值。.env 不入库。

# 模型：minimax-cn 的 api key（也可以用 MINIMAX_API_KEY）
MINIMAX_CN_API_KEY=
AI_MODEL=minimax-cn/MiniMax-M3.1-Flash

# AiAdmin 后端（业务事实源）。base 里已含 /api/v1
AIADMIN_BASE_URL=https://www.pmdict.cn/api/v1

# AiAdmin 的 MySQL（ai_* 元数据表，与业务表同库）
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/aipm

# 允许跨域的前端源（逗号分隔，回具体的源，不用 *）
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
