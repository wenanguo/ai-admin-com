# 复制成 .env 后填真值。.env 不入库。

# 模型：minimax-cn 的 api key（也可以用 MINIMAX_API_KEY）
MINIMAX_CN_API_KEY=
AI_MODEL=minimax-cn/MiniMax-M3.1-Flash

# 默认智能体 id（**配置文件**里的那个，缺省 pm）。
# ⚠️ 调用方没指定智能体时用它 ⇒ 现有 PM 助手的行为靠这条保持不变。
#    可选值见 `backend/ai/agents/` 目录（每个子目录一个智能体）。
AI_DEFAULT_AGENT=pm

# AiAdmin 后端（业务事实源）。base 里已含 /api/v1
AIADMIN_BASE_URL=https://www.pmdict.cn/api/v1

# AiAdmin 的 MCP（**工具的来源**）。
# ⚠️ **不配就不接 MCP**（AI 仍能用，只是没有那些工具）。
#    配了就接 ⇒ 后端的接口自动成为 AI 的能力（后端加接口，AI 侧不用改代码）。
#    地址一般是 ${AIADMIN_BASE_URL}/mcp。
AIADMIN_MCP_URL=

# AiAdmin 的 MySQL（ai_* 元数据表，与业务表同库）
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/aipm

# 本服务**自己**的库（`ai_*` 那 5 张表住这儿）。
# ⚠️ **不配** ⇒ 用上面的共享库（今天的行为，一个字不变）。
#    配了 ⇒ `ai_*` 表在自己的库里 ⇒ 换到别的系统只改这一条。
AI_DATABASE_URL=

# 允许跨域的前端源（逗号分隔，回具体的源，不用 *）
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===== DSH（DeepSeek Harness）=====
# ⚠️ **本文件里一律不许出现 `DSH_` 开头的键**（用 `AI_DSH_` 代替）。
#    dsh 的 app-boot 有 `BOOTSTRAP_PREFIXES = DSH_ / XDG_ / DYLD_ / BASH_FUNC_`
#    ⇒ **任何 .env 文件里写 `DSH_*`，dsh 都会拒绝启动**：
#      dsh: …/.env sets "DSH_BASE_URL", which only the launching environment may set
#    而 dsh 会读它启动目录的 .env（`backend/ai/.env` 就是那个位置）⇒ 照着配就炸。
#    守卫：`node scripts/e2e/dsh-env-names.static.cjs`
# ⚠️ **D3 要验的就是「官方路由」** ⇒ 这里填**官方**的 key，别拿兼容网关冒充。
DEEPSEEK_API_KEY=

# 路由 / 模型 / 地址：缺省就是官方 ⇒ 一般不用改。
# AI_DSH_BASE_URL=https://api.deepseek.com/v1
# AI_DSH_MODEL=deepseek-chat
# AI_DSH_PROVIDER=deepseek-direct
# ⚠️ key 放在**哪个环境变量**里（缺省 DEEPSEEK_API_KEY）。
# AI_DSH_API_KEY_ENV=DEEPSEEK_API_KEY
# 上下文窗口 / 单次输出上限（token）
# AI_DSH_CONTEXT_WINDOW=131072
# AI_DSH_MAX_TOKENS=8192
# dsh 的 home / profile / 可执行文件（缺省就行）
# AI_DSH_HOME=
# AI_DSH_PROFILE=sdk
# AI_DSH_BIN=
# 命令桥的地址（缺省与本服务同端口 ⇒ 一般不用改）
# AI_DSH_BRIDGE_URL=http://127.0.0.1:3100/internal/dsh/commands

# ===== AI 管理面（issue #124：嵌 dsh 自带的 Web UI）=====
# ⚠️ **总开关缺省是关的** ⇒ 不配就不起 dsh web、也没有 /dsh-admin 路由。
AI_DSH_ADMIN_ENABLED=0
# dsh web 监听端口（**只绑 loopback**；缺省 8399）。
# AI_DSH_ADMIN_PORT=8399
# dsh 的 home（**独立目录**，别跟服务的 sdk profile 混；缺省 <AI_DSH_HOME>/dsh-admin）。
# ⚠️ 必须在**可写目录** ⇒ 容器里要挂卷。
# AI_DSH_ADMIN_HOME=
# `--trusted-host` 的值：⚠️ **必须等于浏览器看到的 host[:port]** ⇒ 不对就每个 API 都 403。
# AI_DSH_ADMIN_TRUSTED_HOST=127.0.0.1:3100

# ===== PM 派活（scripts/agent/dispatch.cjs）=====
# ⚠️ 派活器**也读这个文件** ⇒ 一把 key 两处用（不用再导环境变量）。
# ⚠️ 缺省路由按「手里有什么 key」选：
#    - 有 DEEPSEEK_API_KEY ⇒ DeepSeek 官方（deepseek-direct / deepseek-chat）；
#    - 只有 MINIMAX_CN_API_KEY ⇒ MiniMax（minimax / MiniMax-M3.1-Flash）。
# 显式指定（可选）：
# DISPATCH_PROVIDER=deepseek-direct
# DISPATCH_MODEL=deepseek-chat
# DISPATCH_BASE_URL=https://api.deepseek.com/v1
