{
	"name": "ai-admin-ai",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.9.0"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file=.env dist/main.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
