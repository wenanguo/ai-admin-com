{
	"name": "ai-admin-ai",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.9.0"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file=.env dist/main.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"spike:agent": "node --env-file=.env spike/scripts/01-agent-sdk.mjs",
		"spike:matrix": "node --env-file=.env spike/scripts/01b-probe-matrix.mjs",
		"spike:ctx": "node --env-file=.env spike/scripts/01c-probe-ctx-and-concurrency.mjs",
		"spike:db": "node --env-file=.env spike/scripts/02-db-inspect.mjs",
		"spike:prisma": "node --env-file=.env spike/scripts/03-prisma-client.mjs"
	},
	"dependencies": {
		"@ai-admin/dsh-stub": "file:./stubs/dsh-llm-pi-ai",
		"@deepseek-ai/dsh-sdk-client": "0.2.2-rc.5",
		"@prisma/client": "6.19.1",
		"express": "^5.3.0",
		"http-proxy-middleware": "^4.2.2",
		"typebox": "1.3.27",
		"yaml": "^2.9.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@deepseek-ai/dsh": "^0.2.2-rc.5",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"mysql2": "^3.24.6",
		"prisma": "6.19.1",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"@deepseek-ai/dsh-llm-pi-ai": "$@ai-admin/dsh-stub"
	},
	"comment": {
		"overrides": [
			"⚠️ issue #123 · D5=A：把 dsh 自带的「pi-ai 支撑的 provider 适配器」换成本空壳",
			"   ⇒ **pi-ai 物理上不在依赖树里**（我们自己写 provider ⇒ 不需要它）。",
			"   那个适配器在 dsh 侧本来就是休眠的（零路由）⇒ 行为不变。",
			"   详见 stubs/dsh-llm-pi-ai/index.js 与 scripts/e2e/dispatch-dsh.static.cjs。"
		]
	}
}
