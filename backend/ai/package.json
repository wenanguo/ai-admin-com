		"spike:matrix": "node --env-file=.env spike/scripts/01b-probe-matrix.mjs",
		"spike:ctx": "node --env-file=.env spike/scripts/01c-probe-ctx-and-concurrency.mjs",
		"spike:db": "node --env-file=.env spike/scripts/02-db-inspect.mjs",
		"spike:prisma": "node --env-file=.env spike/scripts/03-prisma-client.mjs"
	},
	"dependencies": {
		"@deepseek-ai/dsh-sdk-client": "0.2.2-rc.5",
		"@prisma/client": "6.19.1",
		"express": "^5.3.0",
		"http-proxy-middleware": "^4.2.2",
		"typebox": "1.3.27",
		"yaml": "^2.9.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@deepseek-ai/dsh": "^0.2.2-rc.5",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"mysql2": "^3.24.6",
		"prisma": "6.19.1",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "^5.1.0"
	},
	"comment": {
		"provider": [
			"⚠️ issue #168 · D5=B：provider 归位给 **dsh 自带的** `@deepseek-ai/dsh-llm-pi-ai`。",
			"   ⇒ **不再有 npm overrides / 空壳包**（`stubs/dsh-llm-pi-ai` 已删）⇒ pi-ai 回到依赖树。",
			"   ⇒ 路由由我们生成一段 profile 补丁（baseURL / 模型 / key 的**变量名**）⇒ 密钥不落盘。",
			"   详见 core/adapter/dsh/profile.ts 与 scripts/e2e/dispatch-dsh.static.cjs。"
		]
	}
