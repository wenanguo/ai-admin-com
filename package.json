{
  "name": "ai-admin-com",
  "version": "6.0.3",
  "private": true,
  "description": "AiAdmin monorepo：frontend（Umi 前端）+ backend/ai（Express + pi SDK 的 AI 服务）",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "npm --prefix backend/ai run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend/ai run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:ai": "npm --prefix backend/ai run build",
    "start:ai": "npm --prefix backend/ai run start",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test && npm --prefix backend/ai run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:ai": "npm --prefix backend/ai run test",
    "e2e": "npm --prefix frontend run e2e",
    "e2e:web": "node scripts/e2e/web-container.cjs",
    "e2e:web:static": "node scripts/e2e/web-container.static.cjs",
    "e2e:compose": "node scripts/e2e/compose.cjs",
    "e2e:compose:static": "node scripts/e2e/compose.static.cjs",
    "e2e:ai": "node scripts/e2e/ai-container.cjs",
    "e2e:ai:static": "node scripts/e2e/ai-container.static.cjs",
    "biome": "npm --prefix frontend run biome",
    "tsc": "npm --prefix frontend run tsc && npm --prefix backend/ai run typecheck",
    "prepare": "npm --prefix frontend run prepare"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
