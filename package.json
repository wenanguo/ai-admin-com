{
	"name": "ai-admin-ai",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file=.env dist/main.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"spike:agent": "node --env-file=.env spike/scripts/01-agent-sdk.mjs",
		"spike:matrix": "node --env-file=.env spike/scripts/01b-probe-matrix.mjs",
		"spike:ctx": "node --env-file=.env spike/scripts/01c-probe-ctx-and-concurrency.mjs",
		"spike:db": "node --env-file=.env spike/scripts/02-db-inspect.mjs",
		"spike:prisma": "node --env-file=.env spike/scripts/03-prisma-client.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@prisma/client": "6.19.1",
		"express": "^5.3.0",
		"next": "15.5.29",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typebox": "1.3.27",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"mysql2": "^3.24.6",
		"prisma": "6.19.1",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "^5.1.0"
	}
}
