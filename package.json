{
  "name": "ai-admin-com",
  "version": "6.0.3",
  "private": true,
  "description": "AiAdmin monorepo：frontend（Umi 前端）+ backend/ai（Express + pi SDK 的 AI 服务）",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "npm --prefix backend/ai run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend/ai run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:ai": "npm --prefix backend/ai run build",
    "start:ai": "npm --prefix backend/ai run start",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test && npm --prefix backend/ai run test",
    "test:agent": "node --test scripts/agent/*.test.cjs",
    "test:frontend": "npm --prefix frontend run test",
    "test:ai": "npm --prefix backend/ai run test",
    "e2e": "npm --prefix frontend run e2e",
    "e2e:web": "node scripts/e2e/web-container.cjs",
    "e2e:web:static": "node scripts/e2e/web-container.static.cjs",
    "e2e:compose": "node scripts/e2e/compose.cjs",
    "e2e:compose:static": "node scripts/e2e/compose.static.cjs",
    "e2e:deploy": "node scripts/e2e/deploy.cjs",
    "e2e:deploy-script": "node scripts/e2e/deploy-script.cjs",
    "e2e:ai": "node scripts/e2e/ai-container.cjs",
    "e2e:ai:static": "node scripts/e2e/ai-container.static.cjs",
    "e2e:ai-agent": "node scripts/e2e/ai-agent-picker.cjs",
    "e2e:dsh:static": "node scripts/e2e/dsh-spike.static.cjs",
    "e2e:dsh": "node scripts/e2e/dsh-runner.cjs",
    "e2e:dsh:official": "node scripts/e2e/dsh-official-route.cjs",
    "e2e:dsh:env-names:static": "node scripts/e2e/dsh-env-names.static.cjs",
    "e2e:dsh:profile-refresh": "node scripts/e2e/dsh-profile-refresh.cjs",
    "e2e:dsh:skills-mcp:runtime": "node scripts/e2e/dsh-skills-mcp-plugins.runtime.cjs",
    "e2e:dsh-admin:static": "node scripts/e2e/dsh-admin.static.cjs",
    "check:dsh-boundary": "node scripts/check-dsh-boundary.cjs",
    "e2e:node-version:static": "node scripts/e2e/node-version.static.cjs",
    "check:reuse-core": "node scripts/check-core-reuse.cjs",
    "e2e:reuse-core": "node scripts/e2e/reuse-core-example.cjs",
    "biome": "npm --prefix frontend run biome",
    "tsc": "npm --prefix frontend run tsc && npm --prefix backend/ai run typecheck",
    "prepare": "npm --prefix frontend run prepare"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
